Options -Indexes

<FilesMatch "(?i)(\.(sql|md|log|ini|env|bak|dump)$|^package.*\.json$)">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^\.env(?:\.|$) - [F,L,NC]
RewriteRule ^(?:\.git|scripts|tests|var|backup|backup_sietelsa|database|vendor)(?:/|$) - [F,L,NC]
RewriteRule ^src/config(?:/|$) - [F,L,NC]
RewriteRule ^src/admin/(?:pages|partials)(?:/|$) - [F,L,NC]
RewriteRule ^src/(?:admin|app)/routes\.php$ - [F,L,NC]
