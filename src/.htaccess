Options -Indexes

<FilesMatch "(?i)(\.(sql|md|log|ini|env|bak|dump)$|^package.*\.json$)">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule (^|/)\. - [F,L,NC]
RewriteRule ^(?:scripts|tests|var|backup|backup_sietelsa|database|vendor|config|models|controllers|services|includes|backend|frontend)(?:/|$) - [F,L,NC]
RewriteRule ^(?:admin|app)/routes\.php$ - [F,L,NC]
# Este contexto de Apache reemplaza reglas del padre. Enviar tambien las rutas
# existentes al unico punto de entrada; no ejecutar los controladores PHP antiguos.
RewriteRule ^ ../index.php [END]
