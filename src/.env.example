APP_URL=http://localhost/saas/Saas
APP_PATH=/saas/Saas

# Referencia PHP. La configuracion activa esta en /.env.example y se copia a /.env.
# MySQL usa exclusivamente DB_HOST, DB_PORT, DB_USER, DB_PASSWORD y DB_NAME.
MYSQL_DUMP_PATH=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Compatibilidad opcional con price_id fijos de Stripe.
# STRIPE_PRICE_LIGHT=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ULTRA=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Zentra
MAIL_ENCRYPTION=tls

# Destinatario opcional del formulario de contacto (por defecto MAIL_FROM).
MAIL_CONTACT_TO=
