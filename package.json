{
  "name": "zentra",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch --tsconfig src/backend/tsconfig.json src/backend/main.ts",
    "dev:frontend": "vite --config src/frontend/vite.config.ts",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p src/backend/tsconfig.json",
    "build:frontend": "tsc -p src/frontend/tsconfig.json && vite build --config src/frontend/vite.config.ts",
    "start": "node build/backend/src/backend/main.js",
    "db:migrate": "tsx --tsconfig src/backend/tsconfig.json conexion/migrate.ts",
    "seed:demo": "tsx --tsconfig src/backend/tsconfig.json scripts/seed-demo.ts",
    "create-admin": "tsx --tsconfig src/backend/tsconfig.json scripts/create-admin.ts",
    "test:integration": "tsx --tsconfig src/backend/tsconfig.json tests/stage2.integration.ts",
    "test:browser": "playwright test",
    "typecheck:tests": "tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.0.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.0",
    "nodemailer": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^19.0.0",
    "zod": "^4.1.0"
  },
  "overrides": {
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "parse5": "^8.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
